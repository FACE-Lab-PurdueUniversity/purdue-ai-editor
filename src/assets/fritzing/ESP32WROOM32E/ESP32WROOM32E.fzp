      <views><breadboardView><p svgId="connector26pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gpio0" name="GPIO0" type="male">
      <description>GPIO0 / ADC2 / BOOT</description>
      <views><breadboardView><p svgId="connector25pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gpio2" name="GPIO2" type="male">
      <description>GPIO2 / ADC2 / Touch2</description>
      <views><breadboardView><p svgId="connector24pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gpio15" name="GPIO15" type="male">
      <description>GPIO15 / ADC2 / Touch3 / SPI_SS</description>
      <views><breadboardView><p svgId="connector23pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gpio8" name="GPIO8" type="male">
      <description>GPIO8 / UNSAFE / Internal Flash SD1 - Do Not Use</description>
      <views><breadboardView><p svgId="connector22pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gpio7" name="GPIO7" type="male">
      <description>GPIO7 / UNSAFE / Internal Flash SD0 - Do Not Use</description>
      <views><breadboardView><p svgId="connector21pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gpio6" name="GPIO6" type="male">
      <description>GPIO6 / UNSAFE / Internal Flash CLK - Do Not Use</description>
      <views><breadboardView><p svgId="connector20pin" layer="breadboard"/></breadboardView></views>
    </connector>
  </connectors>
  <buses>
    <bus id="GND">
      <nodeMember connectorId="gnd1"/>
      <nodeMember connectorId="gnd2"/>
      <nodeMember connectorId="gnd3"/>
    </bus>
  </buses>
</module>
