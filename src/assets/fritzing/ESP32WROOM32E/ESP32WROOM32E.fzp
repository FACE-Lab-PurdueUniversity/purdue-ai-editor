    <connector id="gpio3" name="GPIO3" type="male">
      <description>GPIO3 / RX / UART0</description>
      <views><breadboardView><p svgId="connector34pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gpio21" name="GPIO21" type="male">
      <description>GPIO21 / I2C_SDA</description>
      <views><breadboardView><p svgId="connector33pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gnd2" name="GND" type="male">
