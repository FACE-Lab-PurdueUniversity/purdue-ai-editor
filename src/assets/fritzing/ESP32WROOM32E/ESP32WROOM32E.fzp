      <views><breadboardView><p svgId="connector36pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gpio1" name="GPIO1" type="male">
      <description>GPIO1 / TX / UART0</description>
      <views><breadboardView><p svgId="connector35pin" layer="breadboard"/></breadboardView></views>
