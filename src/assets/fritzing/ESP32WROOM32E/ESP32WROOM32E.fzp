    <connector id="gnd3" name="GND" type="male">
      <description>GND / Ground</description>
      <views><breadboardView><p svgId="connector38pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector id="gpio23" name="GPIO23" type="male">
      <description>GPIO23 / SPI_MOSI</description>
